# Worldmeter reads secrets from the Worker environment.
# Locally, copy the keys you have into .dev.vars (Wrangler loads that file).
# In production, set them with `wrangler secret put` — never commit real values.
# Leave a key blank to show "Not configured" for that source.

# Required for the production cron to fan the sweep out across free-plan CPU limits.
# Generate any long random string. Local `wrangler dev` can sweep inline without it.
SWEEP_SECRET=

# OpenSanctions — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# ReliefWeb API v2 approved appname — https://apidoc.reliefweb.int/parameters#appname
# The v1 API is retired and returns HTTP 410. Do not set a shared or guessed name.
RELIEFWEB_APPNAME=

# Cloudflare Radar (Account → Account Analytics → Read)
# https://dash.cloudflare.com/profile/api-tokens
# Named RADAR so it is not confused with the CLOUDFLARE_API_TOKEN Wrangler uses to deploy.
CLOUDFLARE_RADAR_TOKEN=

# ACLED OAuth password grant — https://acleddata.com/register/
ACLED_EMAIL=
ACLED_PASSWORD=

# Optional economic series. The VIX, 10Y–2Y, HY OAS, and GSCPI gauges do not need these.
# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# EIA — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Reddit script app — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
