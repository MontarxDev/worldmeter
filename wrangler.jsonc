{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worldmeter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  "routes": [
    {
      "pattern": "news.montarx.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "14d746f0087748b88fcfc21a8afbe585"
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://news.montarx.com",
    "SOURCE_REPO_URL": "https://github.com/MontarxDev/worldmeter"
  }
}
